{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "njyn-signage",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The API and media routes are handled by the Worker; everything else is static.
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "signage",
      // Replace with the id printed by `npx wrangler d1 create signage`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "njyn-signage-media" }
  ]
  // Secret, set with `npx wrangler secret put ADMIN_PASSWORD`: the dashboard password.
}
