<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Recording your own voice. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- The recorder keeps running while you are in another app, which on
         Android means a foreground service with a persistent notification.
         That notification is this app's equivalent of the desktop tray icon:
         it carries the Stop control. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Once capture stops, the service drops the microphone and projection
         types and finishes transcribing as a data-sync job. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Only used to reach the transcription / summary API you configured.
         There is no other network traffic, no analytics and no account. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Njyn">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Njyn">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".record.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaProjection|dataSync" />
    </application>
</manifest>
