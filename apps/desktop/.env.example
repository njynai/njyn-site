# njyn Meeting Notes - configuration
#
# Copy this to one of:
#   ~/.njyn/.env               (recommended - survives app reinstalls)
#   apps/desktop/.env          (handy while developing)
#
# Every value is optional. With none of them set the app still records and, if
# whisper.cpp is installed, still transcribes - it just cannot write a summary.
# Nothing in this file is ever transmitted anywhere except to the provider it
# belongs to.

# ---------------------------------------------------------------- summaries
# One key is enough. Anthropic is preferred, then OpenAI, then Groq.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Pin a provider instead of letting the app pick: anthropic | openai | groq
# LLM_PROVIDER=anthropic

# Override the summarising model.
# LLM_MODEL=claude-sonnet-5

# ------------------------------------------------------------ transcription
# Leave unset to prefer whisper.cpp whenever a binary and model are present,
# and fall back to a hosted Whisper only when they are not.
# Force it with: local | groq | openai
# TRANSCRIBE_PROVIDER=local

# Where whisper.cpp lives. Unset means "look in the usual places":
#   ~/.njyn/whisper.cpp, ~/whisper.cpp, ./vendor/whisper.cpp, then $PATH
# WHISPER_CPP_PATH=~/whisper.cpp/build/bin/whisper-cli

# The ggml model file. Unset means "look for ggml-medium.bin" in
# ~/.njyn/models and ~/whisper.cpp/models.
# WHISPER_MODEL_PATH=~/.njyn/models/ggml-medium.bin

# Model size to look for when WHISPER_MODEL_PATH is unset.
# WHISPER_MODEL=medium

# Force a language instead of auto-detecting. Use an ISO code, e.g. en, fr, ko.
# WHISPER_LANGUAGE=auto

# CPU threads for whisper.cpp. Unset lets whisper.cpp decide.
# WHISPER_THREADS=8

# ----------------------------------------------------------------- storage
# Where notes and audio are written.
# NOTES_DIR=~/MeetingNotes

# Set to false to delete the .wav once the note is written.
# KEEP_AUDIO=true
