---
import Layout from "../layouts/Layout.astro";
import Mark from "../components/Mark.astro";
import { EMAIL } from "../config";

const principles = [
  { code: "C·01", name: "Engineered, not decorated", blurb: "Everything we ship has a job. If a frame, a feature, or a paragraph does not earn its place, it does not survive the build." },
  { code: "C·02", name: "Proof over promises", blurb: "Games are judged by how they feel in the hand. Systems are judged by the numbers they move. We report both honestly, including when something is not working yet." },
  { code: "C·03", name: "Operators build it", blurb: "NJYN was started by someone who runs real operations every day. We build for the pressure of a busy front desk and a crowded app store, not for a slide deck." },
];
---

<Layout path="/">
  <!-- HERO -->
  <header id="top" class="relative z-10 overflow-hidden pt-36 md:pt-44 pb-16 md:pb-24">
    <div class="heat" aria-hidden="true" style="top:-220px; right:-160px; --accent:#FF4A26;"></div>
    <div class="heat" aria-hidden="true" style="top:120px; right:120px; --accent:#D4AF6A; opacity:.8"></div>

    <div class="grid md:grid-cols-[1.25fr_0.75fr] items-center gap-12 px-6 md:px-20 lg:px-28 relative z-10">
      <div>
        <p class="label text-muted mb-7 flex items-center gap-3.5">
          <span class="inline-block w-9 h-px bg-txt/60"></span>NJYN Inc. · Toronto, Canada
        </p>
        <h1 class="display text-[clamp(3rem,8.4vw,7.4rem)]">
          One core.<br /><span class="serif-accent text-[1.08em]">Two engines.</span>
        </h1>
        <p class="mt-8 max-w-[52ch] text-muted text-[clamp(1rem,1.4vw,1.15rem)] leading-relaxed">
          NJYN Inc. builds in two directions from one centre. <span class="text-ember">NJYN Studio</span> makes
          games. <span class="text-gold">NJYN AI</span> puts AI to work inside businesses. Different
          outputs, same standard of engineering.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a href="/studio" class="display text-[0.85rem] tracking-[0.04em] bg-ember text-obsidian px-8 py-4 no-underline hover:bg-ember2 transition-colors">NJYN Studio &rarr;</a>
          <a href="/ai" class="display text-[0.85rem] tracking-[0.04em] bg-gold text-obsidian px-8 py-4 no-underline hover:bg-gold2 transition-colors">NJYN AI &rarr;</a>
        </div>
      </div>
      <div class="justify-self-center md:justify-self-end">
        <Mark accent="#FF4A26" animate class="mark-dual w-[190px] md:w-[300px] h-auto" label="NJYN Inc. mark" />
      </div>
    </div>
  </header>

  <div class="shimmer-rule relative z-10" aria-hidden="true"></div>

  <!-- DIVISIONS -->
  <section id="divisions" class="relative z-10 py-20 md:py-28">
    <div class="px-6 md:px-20 lg:px-28">
      <div class="rev flex items-baseline justify-between border-b border-white/15 pb-3.5 mb-10 md:mb-14">
        <h2 class="display text-[clamp(1.7rem,3.6vw,2.8rem)]">The divisions</h2>
        <span class="label text-muted hidden sm:block">FIG. 01 · Same mark, different heat</span>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <!-- STUDIO -->
        <a href="/studio" class="rev div-card group block no-underline text-txt border border-ember/30 hover:border-ember bg-obsidian2 overflow-hidden">
          <div class="relative aspect-[16/8] overflow-hidden border-b border-ember/25">
            <img src="/media/studio-poster.jpg" alt="NJYN Studio boot sequence" class="absolute inset-0 w-full h-full object-cover scale-[1.35] group-hover:scale-[1.42] transition-transform duration-700" loading="lazy" />
            <span class="absolute top-4 left-4 label text-ember bg-obsidian/80 px-2.5 py-1.5">D·01 · Games</span>
          </div>
          <div class="p-7 md:p-9">
            <div class="flex items-center gap-3 mb-4">
              <Mark accent="#FF4A26" class="w-[26px] h-auto" />
              <span class="display text-[1.05rem] tracking-[0.06em]">NJYN</span>
              <span class="label text-ember !tracking-[0.3em]">STUDIO</span>
            </div>
            <h3 class="display text-[clamp(1.7rem,3.2vw,2.6rem)]">We make games.</h3>
            <p class="text-muted leading-relaxed mt-4 max-w-[48ch]">
              Mobile-first games built with the obsession of a machine: tight feel, clean systems, no wasted
              frames. Our first title is in development now.
            </p>
            <div class="mt-7 flex items-center justify-between border-t border-ember/20 pt-5">
              <span class="label text-muted">Mobile · In development</span>
              <span class="display text-[0.8rem] tracking-[0.04em] text-ember">Enter the Studio <span class="arrow inline-block">&rarr;</span></span>
            </div>
          </div>
        </a>

        <!-- AI -->
        <a href="/ai" class="rev div-card group block no-underline text-txt border border-gold/30 hover:border-gold bg-obsidian2 overflow-hidden">
          <div class="relative aspect-[16/8] overflow-hidden border-b border-gold/25 bg-panel px-6 pt-14 pb-6 md:p-8 flex flex-col justify-center">
            <span class="absolute top-4 left-4 label text-gold bg-obsidian/80 px-2.5 py-1.5">D·02 · Business</span>
            <div class="label text-muted flex items-center gap-2.5 mb-4"><span class="live-dot"></span>NJYN // automation finder · LIVE</div>
            <div class="terminal-out text-muted !text-[0.8rem]">
              <span class="text-gold">&gt;</span> weekly sales report, built by hand<br />
              <span class="text-gold">&gt;</span> plan: POS + ads + CRM, auto-merged<br />
              <span class="text-gold2">&#10003; 4-6 hours back every week</span><span class="cursor-blink">_</span>
            </div>
          </div>
          <div class="p-7 md:p-9">
            <div class="flex items-center gap-3 mb-4">
              <Mark accent="#D4AF6A" class="w-[26px] h-auto" />
              <span class="display text-[1.05rem] tracking-[0.06em]">NJYN</span>
              <span class="label text-gold !tracking-[0.3em]">AI</span>
            </div>
            <h3 class="display text-[clamp(1.7rem,3.2vw,2.6rem)]">We put AI to work.</h3>
            <p class="text-muted leading-relaxed mt-4 max-w-[48ch]">
              We help businesses bring AI into their daily workflows, automate the routine, and eliminate manual
              work and the errors that come with it. Built on the tools you already use.
            </p>
            <div class="mt-7 flex items-center justify-between border-t border-gold/20 pt-5">
              <span class="label text-muted">Automation · AI integration · Live demo</span>
              <span class="display text-[0.8rem] tracking-[0.04em] text-gold">Enter NJYN AI <span class="arrow inline-block">&rarr;</span></span>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- COMPANY -->
  <section id="company" class="relative z-10 pb-20 md:pb-28">
    <div class="px-6 md:px-20 lg:px-28">
      <div class="rev flex items-baseline justify-between border-b border-white/15 pb-3.5 mb-10 md:mb-14">
        <h2 class="display text-[clamp(1.7rem,3.6vw,2.8rem)]">The company</h2>
        <span class="label text-muted hidden sm:block">FIG. 02 · Built in Toronto</span>
      </div>

      <div class="grid md:grid-cols-[1fr_3fr] gap-10 md:gap-16">
        <div class="rev brackets max-w-[320px] md:max-w-none self-start" style="--accent:#F2EEE6">
          <img src="/images/jason.jpg" alt="Jason Trinh, founder of NJYN Inc." class="block w-full aspect-[4/5] object-cover object-[center_25%]" loading="lazy" />
          <div class="label text-muted flex justify-between border border-t-0 border-white/20 px-4 py-3">
            <span>J. Trinh</span><span class="text-txt">Founder</span>
          </div>
        </div>
        <div class="rev">
          <p class="serif-accent text-[clamp(1.5rem,2.8vw,2.3rem)] leading-snug mb-6">
            Started by an operator, not an agency.
          </p>
          <p class="text-muted leading-relaxed max-w-[62ch] mb-5">
            NJYN Inc. was founded by Jason Trinh, who has spent more than eight years in surgical business
            development and management and runs the business operations of two live healthcare facilities in
            Toronto. Before that came four years building the city's early medical spa market, and underneath it
            all, more than a decade of training teams and running successful retail sales businesses.
          </p>
          <p class="text-muted leading-relaxed max-w-[62ch]">
            That background is the whole point. NJYN builds things that have to work under real pressure, and it
            brings in proven specialists, engineers, strategists, and designers, exactly when the work calls for them.
          </p>

          <div class="mt-10 border-t border-white/15">
            {principles.map((p) => (
              <div class="grid md:grid-cols-[90px_1fr_1.4fr] gap-2 md:gap-8 items-baseline border-b border-white/10 py-6">
                <span class="label text-graphite">{p.code}</span>
                <h3 class="display text-[1.15rem] tracking-[0.02em]">{p.name}</h3>
                <p class="text-muted text-[0.94rem] leading-relaxed">{p.blurb}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="relative z-10 border-t border-white/10 py-24 md:py-32 overflow-hidden">
    <div class="heat" aria-hidden="true" style="bottom:-320px; left:-240px; --accent:#D4AF6A;"></div>
    <div class="px-6 md:px-20 lg:px-28 relative z-10 grid md:grid-cols-[1.2fr_0.8fr] gap-12 items-end">
      <div class="rev">
        <h2 class="display text-[clamp(2.3rem,6vw,5rem)]">
          Building something?<br /><span class="serif-accent">Start at the core.</span>
        </h2>
        <a href={`mailto:${EMAIL}`} class="inline-block mt-10 font-mono text-[clamp(1rem,2vw,1.35rem)] text-txt no-underline border-b-2 border-txt/60 pb-1.5 hover:border-txt transition-colors">{EMAIL}</a>
      </div>
      <div class="rev grid gap-4">
        <a href="/studio" class="div-card flex items-center justify-between border border-ember/30 hover:border-ember px-6 py-5 no-underline text-txt">
          <span><span class="label text-ember block mb-1">Players · Press · Partners</span><span class="display text-[1rem]">NJYN Studio</span></span>
          <span class="arrow text-ember text-xl">&rarr;</span>
        </a>
        <a href="/ai" class="div-card flex items-center justify-between border border-gold/30 hover:border-gold px-6 py-5 no-underline text-txt">
          <span><span class="label text-gold block mb-1">Automation · AI integration</span><span class="display text-[1rem]">NJYN AI</span></span>
          <span class="arrow text-gold text-xl">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  /* Parent mark: the chassis cycles between both divisions */
  .mark-dual .m-roof, .mark-dual .m-floor { animation: roofIn 1.1s cubic-bezier(.2,.9,.25,1.15) .25s both, dual 7s ease-in-out 1.6s infinite; }
  .mark-dual .m-floor { animation-name: floorIn, dual; }
  @keyframes dual { 0%, 42% { fill: #FF4A26; } 50%, 92% { fill: #D4AF6A; } 100% { fill: #FF4A26; } }
  @media (prefers-reduced-motion: reduce) { .mark-dual * { animation: none !important; } }
</style>
